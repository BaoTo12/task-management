# Lombok settings for the whole backend module.
config.stopBubbling = true
# Mark generated code @lombok.Generated: coverage tools (JaCoCo) skip it.
lombok.addLombokGeneratedAnnotation = true
# @RequiredArgsConstructor copies these annotations from a field to the constructor parameter,
# so `@Qualifier("x") private final Foo foo;` still injects the right bean.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
# Loggers made by @Slf4j are named `log`.
lombok.log.fieldName = log
